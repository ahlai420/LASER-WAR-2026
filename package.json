{
  "name": "laser-war",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild scripts/selftest.ts --bundle --platform=node --format=cjs --outfile=.selftest.cjs --log-level=error && node .selftest.cjs",
    "test:ui": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --outfile=.smoke.cjs --loader:.tsx=tsx --jsx=automatic --external:jsdom --log-level=error && node .smoke.cjs",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=cjs --outfile=.balance.cjs --log-level=error && node .balance.cjs",
    "bgm": "bash scripts/make-bgm-loop.sh"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "esbuild": "^0.25.0"
  }
}
